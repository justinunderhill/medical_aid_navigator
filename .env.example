# ─── AI Provider ───────────────────────────────────────────────
# Which provider to use: "anthropic" (default/recommended) or "openai"
AI_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ─── Supabase (feedback storage) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxx

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Medical Aid Navigator
# Single integer. Used by the rate limiter as a simple safeguard.
RATE_LIMIT_PER_MINUTE=20
